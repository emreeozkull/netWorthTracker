# Copy to .env.local (gitignored) and fill in your own values.
# Both are optional; without them the defaults in app.json are used.

# iOS bundle identifier and Android package name, e.g. com.yourname.networth
APP_BUNDLE_ID=

# Your EAS project ID, from `npx eas-cli init` or the project page on expo.dev
EAS_PROJECT_ID=
